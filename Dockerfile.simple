# Simplified Dockerfile for faster development builds
# This version is optimized for speed and testing

FROM node:20-alpine AS builder

# Set working directory
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy only necessary package files first
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

# Copy package.json files for workspaces (minimal dependency copy)
COPY packages/client/package.json packages/client/
COPY packages/revolt.js/package.json packages/revolt.js/
COPY packages/solid-livekit-components/package.json packages/solid-livekit-components/

# Try to create minimal workspace structure
RUN mkdir -p packages/js-lingui-solid/packages/babel-plugin-extract-messages && \
    mkdir -p packages/js-lingui-solid/packages/babel-plugin-lingui-macro && \
    echo '{"name": "@lingui-solid/babel-plugin-extract-messages", "version": "1.0.0"}' > packages/js-lingui-solid/packages/babel-plugin-extract-messages/package.json && \
    echo '{"name": "@lingui-solid/babel-plugin-lingui-macro", "version": "1.0.0"}' > packages/js-lingui-solid/packages/babel-plugin-lingui-macro/package.json

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code (only what we need)
COPY packages/ packages/
COPY eslint.config.mjs .prettierrc .prettierignore ./

# Create minimal builds for dependencies
RUN cd packages/revolt.js && npm run build || echo "Build failed, continuing..." && \
    cd ../solid-livekit-components && npm run build || echo "Build failed, continuing..." && \
    cd ../client && npm run lingui:compile || echo "Lingui compile failed, continuing..."

# Build the client
RUN cd packages/client && npm run build

# Production stage
FROM nginx:alpine

# Remove default nginx website
RUN rm -rf /usr/share/nginx/html/*

# Copy built application
COPY --from=builder /app/packages/client/dist /usr/share/nginx/html

# Create nginx config optimized for SPA
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    gzip on; \
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript; \
    \
    location / { \
        root /usr/share/nginx/html; \
        index index.html; \
        try_files $uri $uri/ /index.html; \
    } \
    \
    location /health { \
        access_log off; \
        return 200 "healthy\\n"; \
        add_header Content-Type text/plain; \
    } \
}' > /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]