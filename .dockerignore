node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
.next/
out/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore
.github/

# Logs
logs/
*.log

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Temporary folders
tmp/
temp/

# Cache directories
.cache/
.parcel-cache/
.eslintcache

# Storybook
storybook-static/
.storybook/

# Testing
.nyc_output/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache
# Ignore local package node_modules and tooling caches that can break context upload
**/node_modules/
**/.pnpm-store/
**/.ignored_convert-source-map


# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Documentation
doc/
*.md
LICENSE

# Screenshots and images not needed for build
*.png
*.jpg
*.jpeg
*.gif

# Development assets that are copied during build
packages/client/assets/

# Ignore specific files
NOTES
GUIDELINES.md
ENHANCED_ADD_MEMBERS_FEATURE.md
QUICK_START_WINDOWS.md
SETUP_COMPLETE.md

# Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore

# Other large directories not needed for build
lifecycle/
.git/
