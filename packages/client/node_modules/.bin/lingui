#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/ubuntu/frontend-stoat-new/node_modules/.pnpm/@lingui+cli@5.3.1_typescript@5.8.3/node_modules/@lingui/cli/dist/node_modules:/home/ubuntu/frontend-stoat-new/node_modules/.pnpm/@lingui+cli@5.3.1_typescript@5.8.3/node_modules/@lingui/cli/node_modules:/home/ubuntu/frontend-stoat-new/node_modules/.pnpm/@lingui+cli@5.3.1_typescript@5.8.3/node_modules/@lingui/node_modules:/home/ubuntu/frontend-stoat-new/node_modules/.pnpm/@lingui+cli@5.3.1_typescript@5.8.3/node_modules:/home/ubuntu/frontend-stoat-new/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/ubuntu/frontend-stoat-new/node_modules/.pnpm/@lingui+cli@5.3.1_typescript@5.8.3/node_modules/@lingui/cli/dist/node_modules:/home/ubuntu/frontend-stoat-new/node_modules/.pnpm/@lingui+cli@5.3.1_typescript@5.8.3/node_modules/@lingui/cli/node_modules:/home/ubuntu/frontend-stoat-new/node_modules/.pnpm/@lingui+cli@5.3.1_typescript@5.8.3/node_modules/@lingui/node_modules:/home/ubuntu/frontend-stoat-new/node_modules/.pnpm/@lingui+cli@5.3.1_typescript@5.8.3/node_modules:/home/ubuntu/frontend-stoat-new/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@lingui/cli/dist/lingui.js" "$@"
else
  exec node  "$basedir/../@lingui/cli/dist/lingui.js" "$@"
fi
